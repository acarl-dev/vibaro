APP_NAME=Vibaro
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vibaro
DB_USERNAME=vibaro
DB_PASSWORD=vibaro

BROADCAST_DRIVER=log
CACHE_STORE=redis
# Legacy compatibility only (do not use as primary):
# CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Comma-separated origins for browser calls to /api and /storage
CORS_ALLOWED_ORIGINS=http://localhost:3000

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=no-reply@vibaro.local
MAIL_FROM_NAME="Vibaro"

# --- Production example values (replace with real infrastructure settings) ---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://api.example.com
#
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=vibaro
# DB_USERNAME=vibaro_app
# DB_PASSWORD=change-me
#
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
#
# FILESYSTEM_DISK=public
#
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=change-me
# MAIL_PASSWORD=change-me
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=no-reply@example.com
# MAIL_FROM_NAME="Vibaro"
#
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com

# Optional (später, wenn du Sanctum Cookie Auth nutzt)
# SESSION_DOMAIN=localhost
# SANCTUM_STATEFUL_DOMAINS=localhost:3000
